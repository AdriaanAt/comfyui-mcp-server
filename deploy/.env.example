# Copy to deploy/.env and fill in. deploy/.env is gitignored - never commit it.

# Broker credentials. These must match the account created in the Mosquitto
# password file (see deploy/mosquitto/config/mosquitto.conf).
MQTT_USERNAME=homecore
MQTT_PASSWORD=change-me

# Serial device for the Zigbee dongle inside the container's host.
# WSL2: /dev/ttyUSB0 after `usbipd attach` (udev does not populate by-id).
# Native Linux: prefer the stable path, e.g.
#   /dev/serial/by-id/usb-ITead_SONOFF_Zigbee_3.0_USB_Dongle_Plus_...-if00-port0
ZIGBEE_DEVICE=/dev/ttyUSB0

TZ=Africa/Johannesburg
